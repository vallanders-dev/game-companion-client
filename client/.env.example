# client/.env - copie este arquivo para client/.env e preencha.
# O client/.env nunca vai pro git (está no .gitignore).

# Endereço do servidor e o seu token de testador - quem organiza o beta
# te passa os dois. O token é só seu: não compartilhe.
SERVER_URL=ws://127.0.0.1:8000/v1/ws
SERVER_AUTH_TOKEN=

# Opcionais (veja client/config.py para todos os padrões):
# CAPTURE_HOTKEY, REMEMBER_HOTKEY, GAMEPAD_COMBO, MIC_*, BARGE_IN,
# FILLER_ENABLED, FILLER_DELAY_MS, OVERLAY, TRAY, VERBOSE_TELEMETRY,
# GAME_DETECT_POLL_SECONDS, GAME_VOICE_MATCH_MIN_RATIO
# AUTO_UPDATE=false desliga a atualização automática ao abrir.
