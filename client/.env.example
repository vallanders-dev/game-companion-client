# client/.env - OPTIONAL, for development only. Testers don't need this
# file: the server address is built in, and the token is entered in the
# window that opens on first launch (saved to %APPDATA%\Parca\settings.json).
# Copy to client/.env to override anything below; it's never committed.

# A different server (e.g. a local `python -m server.main serve`):
# SERVER_URL=ws://127.0.0.1:8000/v1/ws
# A token here wins over the saved one, and the token window never opens:
# SERVER_AUTH_TOKEN=

# Other overrides (see client/config.py for the defaults):
# CAPTURE_HOTKEY, REMEMBER_HOTKEY, GAMEPAD_COMBO, MIC_*, BARGE_IN,
# FILLER_ENABLED, FILLER_DELAY_MS, OVERLAY (the desktop UI; false = console only), VERBOSE_TELEMETRY,
# GAME_DETECT_POLL_SECONDS, GAME_VOICE_MATCH_MIN_RATIO
# AUTO_UPDATE=false turns off the update check at startup.
